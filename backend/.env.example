# =============================================================================
# Report App — Backend Environment Variables
# Copy this file to .env and fill in the values before running the server.
# This file is safe to commit; do not include real credentials.
# =============================================================================

# ── App environment ──────────────────────────────────────────────────────────
# Set to "development" to allow localhost CORS origins automatically.
# Leave as "production" in deployed environments.
APP_ENV=production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Required in production. Example:
#   FRONTEND_ORIGINS=https://dnkreport.netlify.app
FRONTEND_ORIGINS=https://your-frontend.example

# ── File upload limits ───────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes (default: 20).
MAX_UPLOAD_MB=20

# ── Storage ──────────────────────────────────────────────────────────────────
# Root directory for session JSON files, processed DataFrames, previews,
# and final reports. Defaults to app/storage/ relative to the backend root.
# In Docker or Render, mount a persistent volume to this path.
# REPORT_STORAGE_ROOT=./app/storage

# ── PostgreSQL metadata store ────────────────────────────────────────────────
# Uploaded files, processed DataFrames, previews, and reports stay on disk.
# PostgreSQL stores report metadata, statuses, relationships, paths, and
# manual input payloads.
# Local development example (Docker Compose):
DATABASE_URL=postgresql+psycopg://report_app_user:report_app_password@localhost:5432/report_app_db

# Production example (set this in the hosting dashboard or secret manager):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
