# =============================================================================
# Report App — Backend Environment Variables
# Copy this file to .env and fill in the values before running the server.
# =============================================================================

# ── App environment ──────────────────────────────────────────────────────────
# Set to "development" to allow localhost CORS origins automatically.
# Leave as "production" (or omit) in deployed environments.
APP_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Required in production. Example:
#   FRONTEND_ORIGINS=https://dnkreport.netlify.app
FRONTEND_ORIGINS=

# ── File upload limits ───────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes (default: 20).
MAX_UPLOAD_MB=20

# ── Storage ──────────────────────────────────────────────────────────────────
# Root directory for session JSON files, processed DataFrames, previews,
# and final reports. Defaults to app/storage/ relative to the backend root.
# In Docker, mount a persistent volume to this path.
# REPORT_STORAGE_ROOT=./app/storage
